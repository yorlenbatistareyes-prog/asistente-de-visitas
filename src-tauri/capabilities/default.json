{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos completos",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "opener:default",
    "opener:allow-open-path",
    "fs:default",
    "fs:scope",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-stat",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:default",
    "shell:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [
        "**"
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://updates.ejvapps.online/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://updates.ejvapps.online/**"
        }
      ]
    }
  ]
}